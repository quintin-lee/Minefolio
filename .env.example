# ============================================================
# Minefolio 环境变量示例
# 用法: cp .env.example .env，然后按需修改
# README 快速启动: docker compose up -d 会读取 .env（默认拉取 ghcr 镜像）
# ------------------------------------------------------------
# Secret Provider 检索顺序 (backend/src/config/secret.c):
#   1. 内存测试覆盖  2. 外部 Secret Manager 回调
#   3. 环境变量 (MINEFOLIO_<KEY> 或裸 <KEY>)
#   4. 文件: <KEY>_FILE 指定的路径 > /run/secrets/<小写key>
#      (Docker/K8s 标准挂载) > config/secrets/<小写key>
# 生产安全门禁: 值含 change-me / default-secret /
# hard-coded-secret / replace-with- 将拒绝启动，
# 下方占位值仅为示例，上线前必须替换为强随机密钥。
# ============================================================

# ---- 必填: JWT 签名密钥, 生产未设置拒绝启动 ----
# 生成: openssl rand -hex 32
MINEFOLIO_JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars

# ---- 服务端口 (默认 8080, PORT 优先于 MINEFOLIO_PORT) ----
MINEFOLIO_PORT=8080
# PORT=8080

# ---- 数据库 (默认 sqlite + ./data/minefolio.db) ----
# sqlite 或 postgres
MINEFOLIO_DB_DRIVER=sqlite
# SQLite 文件路径示例:
MINEFOLIO_DB_DSN=./data/minefolio.db
# PostgreSQL 连接串示例 (与上一行二选一):
# MINEFOLIO_DB_DSN=host=127.0.0.1 port=5432 user=minefolio password=replace-with-db-password dbname=minefolio sslmode=disable

# ---- 安全中间件 ----
# 严格双重 Cookie CSRF 拦截: 1 开启, 0 关闭 (默认关闭)
MINEFOLIO_ENABLE_CSRF=0
# 允许的前端来源, 为空则反射请求 Origin (本地开发示例):
# MINEFOLIO_CORS_ORIGIN=http://localhost:5173

# ---- GitHub OAuth 单点登录 (可选, 为空即禁用) ----
MINEFOLIO_OAUTH_GITHUB_CLIENT_ID=
MINEFOLIO_OAUTH_GITHUB_CLIENT_SECRET=

# ---- 通用 OIDC 单点登录 (可选, 两项同时配置才生效) ----
MINEFOLIO_OAUTH_OIDC_CLIENT_ID=
MINEFOLIO_OAUTH_OIDC_AUTH_URL=

# ---- AI 财务助理 (可选) ----
# 模型 API Key, 为空则回退到 config/ai.json 内对应 provider 的 api_key
MINEFOLIO_AI_API_KEY=
# AI 配置文件路径 (默认 config/ai.json)
# MINEFOLIO_AI_CONFIG=config/ai.json
# 高风险操作双重确认签名密钥, 为空则回退 MINEFOLIO_JWT_SECRET
# MINEFOLIO_AI_SECRET=

# ---- Docker Secrets / 文件挂载方式 (可选, 与上方环境变量二选一) ----
# MINEFOLIO_JWT_SECRET_FILE=/run/secrets/jwt_secret
# MINEFOLIO_DB_DSN_FILE=/run/secrets/db_dsn

# ---- 前端 (Vite 构建/开发时读取, 留空表示同源) ----
# 本地开发指向后端示例: VITE_API_URL=http://localhost:8080
VITE_API_URL=
