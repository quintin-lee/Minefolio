{
  "name": "minefolio-im-gateway",
  "version": "0.1.0",
  "description": "Minefolio IM bot gateway (QQ/wechat) - bridges IM messages to the read-only /api/im/* endpoints",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "cli": "node cli.js",
    "onebot": "node adapters/onebot-server.js",
    "ilink": "node ilink-server.js",
    "test": "node --test ilink/test/*.test.js adapters/test/*.test.js tests/*.test.js",
    "test:adapters": "node --test adapters/test/*.test.js"
  },
  "dependencies": {}
}
