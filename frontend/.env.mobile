# Mobile mode env (vite --mode mobile / Capacitor build)
# Point this at the REAL backend the mobile app targets.
# Capacitor WebView has no dev proxy, so this MUST be an absolute URL in packaged builds.
# Local dev against the vite dev server (port 5174, proxy on /api) can keep it blank/relative.
VITE_API_URL=http://localhost:8080
