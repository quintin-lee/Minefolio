{
  "name": "minefolio-frontend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "dev:mobile": "vite --config vite.config.mobile.ts --mode mobile",
    "build:mobile": "vue-tsc -b && vite build --config vite.config.mobile.ts --mode mobile && node -e \"require('fs').renameSync('dist-mobile/index.mobile.html', 'dist-mobile/index.html')\"",
    "test": "vitest run --config vite.config.mobile.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/network": "^6.0.0",
    "@element-plus/icons-vue": "^2.3.0",
    "@iconify-icons/ph": "^1.2.5",
    "@iconify/vue": "^5.0.1",
    "axios": "^1.7.0",
    "dompurify": "^3.4.14",
    "echarts": "^5.5.0",
    "element-plus": "^2.7.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.10",
    "mermaid": "^11.17.2",
    "pinia": "^2.1.0",
    "qrcode": "^1.5.4",
    "sql.js": "^1.11.0",
    "vue": "^3.4.0",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/highlight.js": "^9.12.4",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^24.1.0",
    "typescript": "~5.5.0",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  }
}
